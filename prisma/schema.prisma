generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StrategyConfig {
  id               String       @id @default(cuid())
  name             String
  symbol           String       @default("SOXL")
  division         Int
  initialCapital   Float
  cashBalance      Float
  averagePrice     Float
  quantity         Int
  tValue           Float
  mode             String       @default("NORMAL")
  reverseStartedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  trades           Trade[]
}

model Trade {
  id                 String       @id @default(cuid())
  strategyId         String
  strategy           StrategyConfig @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  type               String
  orderType          String
  price              Float
  quantity           Int
  amount             Float
  fee                Float        @default(0)
  tBefore            Float
  tAfter             Float
  cashBefore         Float
  cashAfter          Float
  quantityBefore     Int
  quantityAfter      Int
  averagePriceBefore Float
  averagePriceAfter  Float
  mode               String
  reason             String
  tradedAt           DateTime
  memo               String?
  createdAt          DateTime     @default(now())

  @@index([strategyId, tradedAt])
}

model AppState {
  id        String   @id
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
